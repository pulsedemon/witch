{
  "name": "witch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "witch": "dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "prepare": "husky",
    "dev": "node --import ./scripts/register.mjs src/cli.tsx",
    "build": "node scripts/build.mjs",
    "install:cli": "node --import tsx scripts/install.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node --import tsx scripts/integration.ts",
    "test:integration:codex-brews": "node --import tsx scripts/check-codex-brews.ts",
    "test:record-native": "node --import tsx scripts/record-native-protocol.ts",
    "lint:eslint": "eslint .",
    "lint:compiler": "babel src/ui --extensions .ts,.tsx --out-file /dev/null --env-name lint",
    "lint": "pnpm lint:eslint && pnpm lint:compiler && prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && node dist/cli.js --help > /dev/null && echo check passed",
    "format": "prettier --write ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "fs-ext"
    ]
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "0.3.1",
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "chalk": "6.0.1",
    "diff": "9.0.0",
    "entities": "8.1.0",
    "fs-ext": "2.1.1",
    "ink": "8.0.0",
    "linkify-it": "5.0.2",
    "lowlight": "3.3.0",
    "marked": "17.0.1",
    "react": "19.3.0",
    "string-width": "8.3.0",
    "strip-ansi": "7.2.0",
    "wrap-ansi": "10.0.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@babel/cli": "7.29.7",
    "@babel/core": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@eslint/js": "^10.0.1",
    "@types/babel__core": "7.20.5",
    "@types/fs-ext": "2.0.3",
    "@types/linkify-it": "5.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.12.0",
    "husky": "9.1.7",
    "ink-testing-library": "4.0.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
