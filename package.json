{
  "name": "witch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "witch": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "node --import tsx src/cli.tsx",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:integration": "node --import tsx scripts/integration.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "0.3.1",
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "ansi-escapes": "7.3.0",
    "chalk": "6.0.1",
    "ink": "8.0.0",
    "linkify-it": "5.0.0",
    "marked": "17.0.1",
    "react": "19.3.0",
    "string-width": "8.3.0",
    "strip-ansi": "7.2.0",
    "wrap-ansi": "10.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/linkify-it": "5.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "eslint": "^10.12.0",
    "ink-testing-library": "4.0.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "typescript-eslint": "8.71.1"
  }
}
