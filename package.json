{
  "name": "witch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "witch": "dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev": "node --import ./scripts/register.mjs src/cli.tsx",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/register.mjs --test --test-concurrency=\"$(node -p 'Math.min(4, require(\"node:os\").availableParallelism())')\" test/*.test.ts",
    "test:integration": "node --import tsx scripts/integration.ts",
    "test:integration:codex-brews": "node --import tsx scripts/check-codex-brews.ts",
    "lint": "eslint . && prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && node dist/cli.js --help",
    "format": "prettier --write ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "0.3.1",
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "chalk": "6.0.1",
    "diff": "9.0.0",
    "entities": "8.1.0",
    "ink": "8.0.0",
    "linkify-it": "5.0.2",
    "lowlight": "3.3.0",
    "marked": "17.0.1",
    "react": "19.3.0",
    "string-width": "8.3.0",
    "strip-ansi": "7.2.0",
    "wrap-ansi": "10.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/cli": "7.29.7",
    "@babel/core": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@eslint/js": "^10.0.1",
    "@types/linkify-it": "5.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.12.0",
    "ink-testing-library": "4.0.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "typescript-eslint": "8.71.1"
  }
}
